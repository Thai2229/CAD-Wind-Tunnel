# Nothing reads these yet. They are placeholders for the saved-models phase
# (see docs/DEPLOYMENT.md). Copy to .env.local for local work; never commit real values.

# One bucket per environment, so staging uploads never mix with production.
S3_BUCKET=cad-wind-tunnel-staging
AWS_REGION=us-east-1

# Prefer a short-lived IAM role (Vercel OIDC) over long-lived keys.
# Only set these for local development.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
