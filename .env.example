# Nothing reads these yet. They are placeholders for the saved-models phase
# (see docs/DEPLOYMENT.md and docs/ACCOUNTS.md). Copy to .env.local for local work;
# never commit real values. Set real values in Vercel, scoped per environment.

# Neon Postgres. Server only: never give this a VITE_ prefix.
# One Neon branch per environment (production, staging).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neon Auth sign-in address for this environment's Neon branch. Public, so it can
# reach the browser. Copy the exact value and variable name from the Neon Console.
VITE_NEON_AUTH_URL=https://example.invalid/auth

# One bucket per environment, so staging uploads never mix with production.
S3_BUCKET=cad-wind-tunnel-staging
AWS_REGION=us-east-1

# Prefer a short-lived IAM role (Vercel OIDC) over long-lived keys.
# Only set these for local development.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
